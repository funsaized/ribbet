{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "jsPlugins": ["@stylistic/eslint-plugin"],
  "rules": {
    // `_zod` is Zod's internal marker; the rule otherwise conflicts with the `_` unused-binding convention.
    "no-underscore-dangle": ["warn", { "allow": ["_zod"] }],
    // Flags mutable placeholder closures and micro-optimises nested functions; not applied here.
    "unicorn/consistent-function-scoping": "off",
    // Readability: blank lines around declarations/functions/classes/exports and before returns.
    "@stylistic/padding-line-between-statements": [
      "warn",
      { "blankLine": "always", "prev": "*", "next": "return" },
      { "blankLine": "always", "prev": ["const", "let", "var"], "next": "*" },
      { "blankLine": "any", "prev": ["const", "let", "var"], "next": ["const", "let", "var"] },
      { "blankLine": "always", "prev": "*", "next": ["function", "class", "export"] },
      { "blankLine": "always", "prev": ["function", "class", "export"], "next": "*" },
      { "blankLine": "always", "prev": "import", "next": "*" },
      { "blankLine": "any", "prev": "import", "next": "import" }
    ]
  },
  "overrides": [
    {
      "files": ["src/builtins/exact.ts", "src/builtins/filesystem.ts"],
      "rules": {
        // These files intentionally match control characters to escape/redact them.
        "no-control-regex": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules", "dist", ".cache", "src/generated", "evals/results", "benchmarks", "spikes"]
}
